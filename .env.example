# StoreGuard environment example. Copy to `.env` and adjust.
# NEVER commit a real .env, credentials, API keys, or camera URLs.

# --- API ---
STOREGUARD_ENVIRONMENT=local
# Phase 0 serves in-memory SIMULATED data; no DB is required.
STOREGUARD_USE_IN_MEMORY_SEED=true
# Used only in later phases (PostgreSQL + Alembic).
STOREGUARD_DATABASE_URL=postgresql+psycopg://storeguard:storeguard@localhost:5432/storeguard
# Evidence media store + short-lived signed-URL secret. CHANGE THE SECRET in any
# real deployment (it signs evidence URLs). TTL is in seconds.
STOREGUARD_EVIDENCE_DIR=runs/evidence
STOREGUARD_EVIDENCE_SECRET=change-me-in-production
STOREGUARD_EVIDENCE_URL_TTL_S=300
# Extra CORS origins (comma-separated) for a deployed dashboard, e.g. Netlify.
# Merged with the localhost defaults. Required for the browser to reach the API
# from the deployed web origin.
# STOREGUARD_CORS_ORIGINS_EXTRA=https://your-site.netlify.app

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Mobile (Expo) ---
# On a PHYSICAL device, localhost is the phone itself — set this to your dev
# host's LAN IP, e.g. http://192.168.1.42:8000. A simulator can use localhost.
EXPO_PUBLIC_API_BASE=http://localhost:8000

# --- Postgres (docker compose) ---
POSTGRES_USER=storeguard
POSTGRES_PASSWORD=storeguard
POSTGRES_DB=storeguard
