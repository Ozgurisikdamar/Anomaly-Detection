# StoreGuard environment example. Copy to `.env` and adjust.
# NEVER commit a real .env, credentials, API keys, or camera URLs.

# --- API ---
STOREGUARD_ENVIRONMENT=local
# Phase 0 serves in-memory SIMULATED data; no DB is required.
STOREGUARD_USE_IN_MEMORY_SEED=true
# Used only in later phases (PostgreSQL + Alembic).
STOREGUARD_DATABASE_URL=postgresql+psycopg://storeguard:storeguard@localhost:5432/storeguard

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE=http://localhost:8000

# --- Postgres (docker compose) ---
POSTGRES_USER=storeguard
POSTGRES_PASSWORD=storeguard
POSTGRES_DB=storeguard
